                ],
                "note": "Aus dem Microsoft-Connector; in der API-Doku nicht beschrieben."
            }
        ],
        "hosts": {
            "account": "https://deepcloud.swiss/api/v1"
        }
    },
    "settings": [
        {
            "key": "demo",
            "type": "check",
            "label": "Demo-Modus (simulierte Antworten, nichts geht an DeepSign)",
            "default": true,
            "help": "Für Tests ohne Zugang und auf dem Testserver. Ausschalten erst mit Zugang und auf dem Schweizer Server."
        },
        {
            "key": "endtest",
            "type": "check",
            "label": "Endtest: echte Aufrufe auf diesem Server erlauben (Server ausserhalb der Schweiz)",
            "default": false,
            "help": "Nur für den Endtest mit erfundenen Dokumenten und eigener E-Mail. Ohne diesen Schalter bleibt auf einem Server ausserhalb der Schweiz der Demo-Modus erzwungen. Nach dem Test wieder ausschalten."
        },
        {
            "key": "environment",
            "type": "select",
            "label": "Umgebung",
            "default": "https://deepcloud.swiss",
            "choices": [
                [
                    "https://deepcloud.swiss",
                    "Produktion (deepcloud.swiss)"
                ],
                [
                    "https://int.deepcloud.swiss",
                    "Test (int.deepcloud.swiss)"
                ]
            ],
            "help": "Anmeldung und Erstellen des Service-Benutzers (DeepAdmin) in dieser Umgebung."
        },
        {
            "key": "base_url",
            "type": "url",
            "label": "API-Adresse",
            "default": "https://api.sign.deepbox.swiss/api/v1",
            "help": "Produktion: https://api.sign.deepbox.swiss/api/v1. Die Adresse der Testumgebung bei DeepCloud erfragen."
        },
        {
            "key": "client_id",
            "type": "password",
            "label": "Partner-Client: client_id",
            "required": true,
            "required_unless": "demo"
        },
        {
            "key": "client_secret",
            "type": "password",
            "label": "Partner-Client: client_secret",
            "required": true,
            "required_unless": "demo"
        },
        {
            "key": "username",
            "type": "password",
            "label": "Service-Benutzer",
            "help": "Mit der Aktion «Service-Benutzer erstellen» erzeugen und hier einfügen (wird nur einmal angezeigt)."
        },
        {
            "key": "password",
            "type": "password",
            "label": "Passwort des Service-Benutzers",
            "help": "Mit der Aktion «Service-Benutzer erstellen» erzeugen und hier einfügen (wird nur einmal angezeigt)."
        },
        {
            "key": "company_id",
            "type": "text",
            "label": "Firma (companyId, optional)",
            "help": "Nur nötig, wenn der Service-Benutzer mehrere Firmen sieht."
        },
        {
            "key": "initiator_alias",
            "type": "text",
            "label": "Absendername in den Einladungen",
            "default": "Sekundarschule Bülach"
        },
        {
            "key": "signature_mode",
            "type": "select",
            "label": "Signaturstufe (Vorgabe)",
            "default": "timestamp",
            "choices": [
                [
                    "timestamp",
                    "Einfach (Zeitstempel)"
                ],
                [
