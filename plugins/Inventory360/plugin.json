    "settings": [
        {
            "key": "base_url",
            "type": "url",
            "label": "Adresse der Inventory360-Instanz",
            "required": true,
            "placeholder": "https://sekbuelach.inventory360.de",
            "help": "Ohne /api/2.0 am Ende."
        },
        {
            "key": "api_token",
            "type": "password",
            "label": "API-Token",
            "required": true
        },
        {
            "key": "auth_header",
            "type": "text",
            "label": "Kopfzeile für das Token",
            "default": "Authorization"
        },
        {
            "key": "auth_prefix",
            "type": "select",
            "label": "Präfix",
            "default": "none",
            "choices": [
                ["none", "ohne (laut Referenz)"],
                ["Bearer", "Bearer"],
                ["Token", "Token"]
            ],
            "help": "Laut API-2.0-Referenz ohne Präfix."
        }
    ],
    "actions": [
        {
            "id": "search",
            "label": "Inventar durchsuchen",
            "kind": "read",
            "options": [
                {
                    "key": "search",
                    "type": "text",
                    "label": "Suchbegriff (Inventarnummer, Name …)"
                },
                {
                    "key": "per_page",
                    "type": "number",
                    "label": "Anzahl",
                    "default": 50
                }
            ]
        },
        {
            "id": "device",
            "label": "Gerät anzeigen",
            "kind": "read",
            "options": [
                {
                    "key": "inventorynumber",
                    "type": "text",
                    "label": "Inventarnummer",
                    "required": true
                }
            ]
        },
        {
            "id": "categories",
            "label": "Hardware-Kategorien",
            "kind": "read",
            "options": []
        }
    ]
