{
    "id": "inventory360",
    "name": "Inventory360",
    "version": "1.0",
    "api": 1,
    "category": "inventory",
    "author": "SekBülach Intranet",
    "description": "Hardware-Inventar aus Inventory360 (enteksystems, API 2.0): Verbindung prüfen, Inventar durchsuchen, Gerät nach Inventarnummer, Hardware-Kategorien; alle lesenden Endpunkte der API-2.0-Referenz im API-Tester.",
    "data_notice": "Inventory360 enthält Zuordnungen von Geräten zu Personen (Besitzer, Benutzer, Mitarbeitende). Auf dem Testserver (nicht in der Schweiz) nur die Verbindung prüfen.",
    "service": {
        "name": "Inventory360 API 2.0",
        "home": "https://www.enteksystems.de",
        "docs": "https://docs.enteksystems.de/inventory360/api/2.0/",
        "auth": {
            "type": "header",
            "setting": "api_token",
            "header": "Authorization",
            "header_setting": "auth_header",
            "prefix_setting": "auth_prefix"
        },
        "auth_note": "In Inventory360 unter Admin → API → «Hinzufügen» einen Zugang anlegen (nur Lesen genügt). Laut API-2.0-Referenz wird das Token unverändert in der Kopfzeile «Authorization» übergeben (ohne «Bearer»). Prüfen lässt es sich ohne Kopfzeile mit POST /checkToken.",
        "endpoints": [
            {
                "id": "hardware",
                "method": "GET",
                "path": "/api/2.0/assets/hardware",
                "label": "Hardware-Inventar",
                "status": "partial",
                "use": "Verbindungstest, Inventar durchsuchen",
                "note": "Mit per_page Antwort {_query:{total,pages,page,next,prev}, results:[…]}, sonst Liste. Felder ausser id, inventorynumber, name in der Referenz nicht beschrieben.",
                "params": [
                    {
                        "name": "search",
                        "example": "Inventarnummer oder Name"
                    },
                    {
                        "name": "per_page",
                        "default": "50"
                    },
                    {
                        "name": "page",
                        "default": "1"
                    },
                    {
                        "name": "hwcat_id",
                        "help": "Kategorie-ID, mehrere mit Komma"
                    },
                    {
                        "name": "hwtype_id",
                        "help": "Typ-ID, mehrere mit Komma"
                    },
                    {
                        "name": "discovery",
                        "help": "0 oder 1: mit Discovery-Daten"
                    },
                    {
                        "name": "scancodes",
                        "help": "0 oder 1: mit Scancodes"
                    }
                ]
            },
            {
                "id": "hardware-get",
                "method": "GET",
                "path": "/api/2.0/assets/hardware/{inventorynumber}",
                "label": "Gerät nach Inventarnummer",
                "status": "partial",
                "use": "Aktion «Gerät anzeigen»",
                "params": [
                    {
                        "name": "inventorynumber",
                        "required": true
                    },
                    {
                        "name": "discovery",
                        "help": "0 oder 1"
                    }
                ]
            },
            {
                "id": "hardware-discovery",
                "method": "GET",
                "path": "/api/2.0/assets/hardware/{inventorynumber}/discovery",
                "label": "Discovery-Daten eines Geräts",
                "status": "partial",
                "params": [
                    {
                        "name": "inventorynumber",
                        "required": true
                    }
                ]
            },
            {
                "id": "hardware-files",
                "method": "GET",
                "path": "/api/2.0/assets/hardware/{inventorynumber}/files",
                "label": "Dateien eines Geräts",
                "status": "partial",
                "params": [
                    {
                        "name": "inventorynumber",
                        "required": true
                    }
                ]
            },
