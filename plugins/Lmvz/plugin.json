{
    "id": "lmvz",
    "name": "LMVZ – Lehrmittelverlag Zürich (inoffiziell)",
    "version": "0.2",
    "api": 1,
    "category": "school",
    "author": "SekBülach Intranet",
    "unofficial": true,
    "description": "Inoffizielle Anbindung an den LMVZ: Webshop (öffentliche Artikelseiten: Titel, Artikelnummer, ISBN, Preis) und LMVZ Digital (digital.lmvz.ch: Lizenzübersicht der Schule, Benutzer, Gruppen). Der LMVZ bietet keine offizielle Schnittstelle; die Endpunkte von LMVZ Digital stammen aus einer Aufzeichnung mit dem API-Recorder.",
    "data_notice": "Keine offizielle Schnittstelle: Shop-Seiten und die interne REST-Schnittstelle von LMVZ Digital können sich ohne Vorwarnung ändern. LMVZ Digital enthält Personendaten von Schüler:innen und Lehrpersonen (Namen, E-Mail, Klassen) – nur auf einem Server in der Schweiz und nach Klärung mit dem LMVZ (Nutzungsbedingungen) mit echten Daten verwenden. Das Token gilt nur für digital.lmvz.ch und wird nie an den Shop gesendet.",
    "service": {
        "name": "LMVZ Webshop und LMVZ Digital (keine offizielle API)",
        "home": "https://shop.lmvz.ch",
        "docs": "https://support.lmvz.ch",
        "base": "https://shop.lmvz.ch",
        "auth": {
            "type": "header",
            "hosts": ["digital"],
            "header_setting": "auth_header",
            "prefix_setting": "auth_prefix",
            "setting": "digital_token"
        },
        "auth_note": "Shop: ohne Anmeldung. LMVZ Digital: Anmeldung über das Schulkonto (Keycloak). Das Zugriffstoken aus dem angemeldeten Browser (Entwicklertools → Netzwerk → Kopfzeile «Authorization» einer Anfrage an /rest/…) hier hinterlegen; es läuft nach kurzer Zeit ab. Eine dauerhafte Anmeldung (Dienstkonto, Client Credentials) müsste der LMVZ bereitstellen.",
        "endpoints": [
            {
                "id": "home",
                "method": "GET",
                "path": "/de/",
                "label": "Shop erreichbar",
                "status": "partial",
                "use": "Testen",
                "note": "HTML-Seite, keine API."
            },
            {
                "id": "product",
                "method": "GET",
                "path": "/de/Katalog/{reihe}/{artikel}.html",
                "label": "Artikelseite",
                "status": "partial",
                "use": "Artikel nachschlagen",
                "note": "HTML-Seite; Angaben aus Meta-Daten und Seitentext gelesen (Aufbau nicht zugesichert). Beispiel: Reihe «New-Inspiration», Artikel «New-Inspiration-3-Workbook-7334».",
                "params": [
                    {
                        "name": "reihe",
                        "required": true,
                        "example": "New-Inspiration"
                    },
                    {
                        "name": "artikel",
                        "required": true,
                        "example": "New-Inspiration-3-Workbook-7334"
                    }
                ]
            },
            {
                "id": "basket",
                "method": "GET",
                "path": "/de/basket.htm",
                "label": "Warenkorb (Schulkonto)",
                "status": "planned",
                "use": "später: Bestellung vorbereiten",
                "note": "Braucht eine Anmeldung im Shop; Ablauf zuerst mit dem API-Recorder aufzeichnen."
            },
            {
                "id": "d-org",
                "method": "GET",
                "path": "/rest/clientpreferences/{orgId}",
                "host": "digital",
                "label": "Schule (Organisation)",
                "status": "partial",
                "use": "Testen, Schulname",
                "note": "Aus einer Aufzeichnung mit dem API-Recorder (digital.lmvz.ch, Oktober 2026); keine Hersteller-Doku.",
                "params": [
                    {
                        "name": "orgId",
                        "required": true,
                        "help": "Organisations-ID der Schule (Einstellung «org_id»)",
                        "setting": "org_id"
                    }
                ]
            },
            {
                "id": "d-licenses",
                "method": "POST",
                "path": "/rest/lizenzpakete/{view}/orgId/{orgId}",
                "host": "digital",
                "label": "Lizenzübersicht der Schule",
                "status": "partial",
                "use": "Aktion «Lizenzübersicht», Kachel",
                "note": "Liste per POST (lesend). Antwort: licenseOverviewOneYearEP mit gekauften, zugewiesenen und freien Lizenzen je Lehrmittel. Aus einer Aufzeichnung mit dem API-Recorder (digital.lmvz.ch, Oktober 2026); keine Hersteller-Doku.",
                "effect": "read",
                "params": [
                    {
                        "name": "view",
                        "required": true,
                        "help": "Erster Wert im aufgezeichneten Pfad (Bedeutung noch unklar, Einstellung «license_view»)",
                        "setting": "license_view"
                    },
                    {
                        "name": "orgId",
                        "required": true,
                        "help": "Organisations-ID der Schule (Einstellung «org_id»)",
                        "setting": "org_id"
                    }
                ],
                "body": {
                    "sorting": [],
                    "offset": 0,
                    "limit": 0
                }
            },
