{
    "key": "zeiterfassung",
    "name": "Zeiterfassung",
    "version": "0.12.2",
    "core": ">=0.32.0",
    "description": "Arbeitszeit mit Buchungsart (Arbeitszeit, Homeoffice, Ferien, Krankheit …), Tätigkeiten, Projekte und Abwesenheiten pro Monat erfassen; Monatsvisum durch die Schulleitung, Export für die Lohnbuchhaltung und Monatsblatt als PDF; visierte Monatsrapporte elektronisch unterschreiben (DeepSign).",
    "aktiv": true,
    "datenklasse": "vertraulich",
    "db_schema": "zeit",
    "provider": "Modules\\Zeiterfassung\\ModuleServiceProvider",
    "rechte": {
        "use-zeiterfassung": {
            "label": "Eigene Arbeitszeit erfassen",
            "roles": [
                "admin",
                "schulleitung",
                "verwaltung",
                "ict",
                "redaktion",
                "lehrperson",
                "mitarbeitende"
            ]
        },
        "korrigieren-zeiterfassung": {
            "label": "Buchungen aus ClickTime korrigieren (an ClickTime senden)",
            "roles": ["admin", "schulleitung"]
        },
        "visum-zeiterfassung": {
            "label": "Zeiterfassung aller einsehen, Monate visieren, Export Lohnbuchhaltung",
            "roles": ["admin", "schulleitung"]
        },
        "oeffnen-zeiterfassung": {
            "label": "Abgeschlossene Monate wieder öffnen",
            "roles": ["admin", "schulleitung"]
        },
        "config-zeiterfassung": {
            "label": "Zeiterfassung einstellen (Prüfhinweise)",
            "roles": ["admin", "schulleitung"]
        }
    },
    "menu": {
        "gruppe": "organisation",
        "eintraege": {
            "meine": {
                "title": "Zeiterfassung",
                "icon": "EduksxTime",
                "href": "/zeiterfassung",
                "can": "use-zeiterfassung"
            },
            "visum": {
                "title": "Zeiterfassung – Visum",
                "icon": "ClipboardCheck",
                "href": "/zeiterfassung/visum",
                "can": "visum-zeiterfassung"
            },
            "einstellungen": {
                "title": "Zeiterfassung – Einstellungen",
                "icon": "SlidersHorizontal",
                "href": "/zeiterfassung/einstellungen",
                "can": "config-zeiterfassung"
            }
        }
    },
    "sammlungen": {
        "zeit_eintraege": {
            "label": "Zeiterfassung: Einträge",
            "description": "Ein Eintrag je Arbeitsblock oder Abwesenheit (Stunden). Abwesenheiten ohne Grund/Diagnose.",
            "fields": {
                "person_id": {
                    "type": "ref",
                    "references": "users",
                    "required": true,
                    "label": "Person"
                },
                "datum": {
                    "type": "date",
                    "required": true,
                    "label": "Datum"
                },
                "monat": {
                    "type": "string",
                    "required": true,
                    "label": "Monat (JJJJ-MM)"
                },
                "art": {
                    "type": "enum",
                    "values": {
                        "arbeit": "Arbeit",
                        "abwesenheit": "Abwesenheit"
                    },
                    "required": true,
                    "label": "Art"
                },
                "buchungsart": {
                    "type": "string",
                    "required": false,
                    "label": "Buchungsart (Schlüssel, fehlt = aus Art und Kategorie)"
                },
                "kategorie": {
                    "type": "string",
                    "required": true,
                    "label": "Kategorie / Tätigkeit"
                },
                "beginn": {
                    "type": "string",
                    "required": false,
                    "label": "Beginn (HH:MM)"
                },
                "ende": {
                    "type": "string",
                    "required": false,
                    "label": "Ende (HH:MM)"
                },
                "pause_min": {
                    "type": "int",
                    "required": false,
                    "label": "Pause (Minuten)"
                },
                "stunden": {
                    "type": "decimal",
                    "required": true,
                    "label": "Stunden"
                },
                "projekt": {
                    "type": "string",
                    "required": false,
                    "label": "Projekt / Einsatz"
                },
                "notiz": {
                    "type": "text",
                    "required": false,
                    "label": "Notiz"
                },
                "quelle": {
                    "type": "string",
                    "required": false,
                    "label": "Quelle (leer = von Hand, clicktime = übernommen)"
                },
                "quelle_id": {
                    "type": "string",
                    "required": false,
                    "label": "ID in der Quelle (ClickTime-Nr. der Buchung)"
                },
                "quelle_status": {
                    "type": "string",
                    "required": false,
                    "label": "Status in der Quelle (ClickTime: approval_status, Genehmigung)"
                }
            }
        },
        "zeit_monate": {
            "label": "Zeiterfassung: Monate",
            "description": "Status je Person und Monat (id = Person:JJJJ-MM): offen, eingereicht, visiert, zurück, in ClickTime abgeschlossen.",
            "fields": {
                "person_id": {
                    "type": "ref",
                    "references": "users",
                    "required": true,
                    "label": "Person"
                },
                "monat": {
                    "type": "string",
                    "required": true,
                    "label": "Monat (JJJJ-MM)"
                },
                "status": {
                    "type": "enum",
                    "values": {
                        "offen": "Offen",
                        "eingereicht": "Eingereicht",
                        "visiert": "Visiert",
                        "zurueck": "Zurück an Person",
                        "abgeschlossen": "In ClickTime abgeschlossen"
                    },
                    "required": true,
                    "label": "Status"
                },
                "stunden": {
                    "type": "decimal",
                    "required": false,
                    "label": "Stunden total (beim Einreichen)"
                },
                "eingereicht_at": {
                    "type": "datetime",
                    "required": false,
                    "label": "Eingereicht am"
                },
                "visiert_by": {
                    "type": "ref",
                    "references": "users",
                    "required": false,
                    "label": "Visiert von"
                },
                "visiert_at": {
                    "type": "datetime",
                    "required": false,
                    "label": "Visiert am"
                },
                "bemerkung": {
                    "type": "text",
                    "required": false,
                    "label": "Bemerkung Schulleitung"
                },
                "unterschrift_status": {
                    "type": "enum",
                    "values": {
                        "versendet": "Zur Unterschrift",
                        "teilweise": "Teilweise unterschrieben",
                        "unterschrieben": "Unterschrieben",
                        "abgelehnt": "Abgelehnt",
                        "zurueckgezogen": "Zurückgezogen",
                        "abgelaufen": "Abgelaufen",
                        "entwurf": "Entwurf"
                    },
                    "required": false,
                    "label": "Unterschrift (Status)"
                },
                "unterschrift_id": {
                    "type": "string",
                    "required": false,
                    "label": "Unterschrift: Auftrag (signature_requests)"
                },
                "unterschrift_at": {
                    "type": "datetime",
                    "required": false,
                    "label": "Unterschrieben am"
                },
                "unterschrift_pdf": {
                    "type": "string",
                    "required": false,
                    "label": "Unterschriebenes PDF (Ablage des Moduls)"
                },
                "abgeschlossen_at": {
                    "type": "datetime",
                    "required": false,
                    "label": "In ClickTime abgeschlossen, bestätigt am (#164)"
                },
                "abgeschlossen_by": {
                    "type": "ref",
                    "references": "users",
                    "required": false,
                    "label": "Bestätigt von (Person oder stellvertretend)"
                },
                "abgeschlossen_stellvertretend": {
                    "type": "bool",
                    "required": false,
                    "label": "Stellvertretend bestätigt"
                },
                "abweichung": {
                    "type": "json",
                    "required": false,
                    "label": "Nachbuchungen in ClickTime nach dem Abschluss (Anzahl, geprüft am)"
                },
                "monatsblatt_pdf": {
                    "type": "string",
                    "required": false,
                    "label": "Monatsblatt (PDF, Ablage des Moduls, #34)"
                },
                "monatsblatt_at": {
                    "type": "datetime",
                    "required": false,
                    "label": "Monatsblatt erstellt am"
                },
                "erinnert_at": {
                    "type": "datetime",
                    "required": false,
                    "label": "Zuletzt erinnert am (#33)"
                },
                "geoeffnet_at": {
                    "type": "datetime",
                    "required": false,
                    "label": "Wieder geöffnet am (#206)"
                },
                "geoeffnet_by": {
                    "type": "ref",
                    "references": "users",
                    "required": false,
                    "label": "Wieder geöffnet von"
                },
                "unterschrift_vorgesetzte": {
                    "type": "ref",
                    "references": "users",
                    "required": false,
                    "label": "Unterschrift: vorgesetzte Person (von der Person gestartet, #208)"
                },
                "dossier_status": {
                    "type": "enum",
                    "values": {
                        "abgelegt": "Im Dossier abgelegt",
                        "kein_dossier": "Kein Dossier verknüpft",
                        "ausstehend": "Ausstehend (Schnittstelle nicht aktiv)",
                        "fehler": "Fehler"
                    },
                    "required": false,
                    "label": "Kopie ins Dossier (CMI)"
                },
                "dossier_at": {
                    "type": "datetime",
                    "required": false,
                    "label": "Im Dossier abgelegt am"
                }
            }
        },
        "zeit_buchungsarten": {
            "label": "Zeiterfassung: Buchungsarten",
            "description": "Pflegbare Liste (id = Schlüssel): Arbeit oder Abwesenheit. Ohne gespeicherte Liste gilt die Vorgabe.",
            "fields": {
                "name": {
                    "type": "string",
                    "required": true,
                    "label": "Bezeichnung"
                },
                "art": {
                    "type": "enum",
                    "values": {
                        "arbeit": "Arbeit",
                        "abwesenheit": "Abwesenheit"
                    },
                    "required": true,
                    "label": "Art"
                },
                "aktiv": {
                    "type": "bool",
                    "required": true,
                    "label": "Aktiv (zur Auswahl)"
                },
                "reihenfolge": {
                    "type": "int",
                    "required": false,
                    "label": "Reihenfolge"
                }
            }
        },
        "zeit_soll": {
            "label": "Zeiterfassung: Sollzeit",
            "description": "Sollzeit pro Person und Monat (id = Person:Monat), pro Tag in Stunden, z. B. aus ClickTime.",
            "fields": {
                "person_id": {
                    "type": "ref",
                    "references": "users",
                    "required": true,
                    "label": "Person"
                },
                "monat": {
                    "type": "string",
                    "required": true,
                    "label": "Monat (JJJJ-MM)"
                },
                "tage": {
                    "type": "json",
                    "required": true,
                    "label": "Soll pro Tag (Datum → Stunden)"
                },
                "quelle": {
                    "type": "string",
                    "required": false,
                    "label": "Herkunft (z. B. clicktime)"
                }
            }
        },
        "zeit_einstellungen": {
            "label": "Zeiterfassung: Einstellungen",
            "description": "Einstellungen der Zeiterfassung (id = Bereich, z. B. «pruefungen» für die Prüfhinweise). Ohne Datensatz gilt die Vorgabe.",
            "fields": {
                "kommen_fehlt": {
                    "type": "bool",
                    "required": false,
                    "label": "Hinweis: Kommen-Buchung fehlt"
                },
                "gehen_fehlt": {
                    "type": "bool",
                    "required": false,
                    "label": "Hinweis: Gehen-Buchung fehlt"
                },
                "keine_buchung": {
                    "type": "bool",
                    "required": false,
                    "label": "Hinweis: keine Buchung vorhanden"
                },
                "tagesist": {
                    "type": "bool",
                    "required": false,
                    "label": "Hinweis: Tagesist über Grenze"
                },
                "tagesist_max": {
                    "type": "string",
                    "required": false,
                    "label": "Grenze Tagesist (hh:mm)"
                },
                "abweichung": {
                    "type": "bool",
                    "required": false,
                    "label": "Hinweis: Tagesdifferenz zum Soll"
                },
                "abweichung_prozent": {
                    "type": "int",
                    "required": false,
                    "label": "Abweichung in Prozent"
                },
                "mittag": {
                    "type": "bool",
                    "required": false,
                    "label": "Hinweis: keine Mittagsbuchung"
                },
                "mittag_von": {
                    "type": "string",
                    "required": false,
                    "label": "Mittag von (hh:mm)"
                },
                "mittag_bis": {
                    "type": "string",
                    "required": false,
                    "label": "Mittag bis (hh:mm)"
                },
                "mittag_min": {
                    "type": "int",
                    "required": false,
                    "label": "Mindestpause (Minuten)"
                }
            }
        },
        "zeit_vorgesetzte": {
            "label": "Zeiterfassung: Vorgesetzte",
            "description": "Vorgesetzte je Person (id = Person), unterschreiben den Monatsrapport mit. Aus ClickTime oder von Hand (quelle = hand, wird beim Import nicht überschrieben).",
            "fields": {
                "vorgesetzte": {
                    "type": "json",
                    "required": true,
                    "label": "Vorgesetzte (Personen-IDs)"
                },
                "quelle": {
                    "type": "string",
                    "required": false,
                    "label": "Herkunft (clicktime oder hand)"
                }
            }
        }
    },
    "ereignisse": {
        "sendet": [
            "zeit.monat_eingereicht",
            "zeit.monat_visiert",
            "zeit.monat_zurueck",
            "zeit.monat_geoeffnet",
            "zeit.monat_unterschrieben",
            "zeit.monat_abgeschlossen",
            "zeit.monat_nachbuchung",
            "zeit.erinnerung"
        ],
        "empfaengt": [
            "signatur.unterschrieben",
            "signatur.abgeschlossen",
            "signatur.abgelehnt"
        ]
    },
    "plugins": ["deepsign", "clicktime"]
}
