{
    "key": "zeiterfassung",
    "name": "Zeiterfassung",
    "version": "0.4.0",
    "core": ">=0.32.0",
    "description": "Arbeitszeit mit Buchungsart (Arbeitszeit, Homeoffice, Ferien, Krankheit …), Tätigkeiten, Projekte und Abwesenheiten pro Monat erfassen; Monatsvisum durch die Schulleitung, Export für die Lohnbuchhaltung und Monatsblatt als PDF; visierte Monatsrapporte elektronisch unterschreiben (DeepSign).",
    "aktiv": true,
    "datenklasse": "vertraulich",
    "db_schema": "zeit",
    "provider": "Modules\\Zeiterfassung\\ModuleServiceProvider",
    "rechte": {
        "use-zeiterfassung": {
            "label": "Eigene Arbeitszeit erfassen",
            "roles": [
                "admin",
                "schulleitung",
                "verwaltung",
                "ict",
                "redaktion",
                "lehrperson",
                "mitarbeitende"
            ]
        },
        "visum-zeiterfassung": {
            "label": "Zeiterfassung aller einsehen, Monate visieren, Export Lohnbuchhaltung",
            "roles": ["admin", "schulleitung"]
        }
    },
    "menu": {
        "gruppe": "organisation",
        "eintraege": {
            "meine": {
                "title": "Zeiterfassung",
                "icon": "Clock",
                "href": "/zeiterfassung",
                "can": "use-zeiterfassung"
            },
            "visum": {
                "title": "Zeiterfassung – Visum",
                "icon": "ClipboardCheck",
                "href": "/zeiterfassung/visum",
                "can": "visum-zeiterfassung"
            }
        }
    },
    "sammlungen": {
        "zeit_eintraege": {
            "label": "Zeiterfassung: Einträge",
            "description": "Ein Eintrag je Arbeitsblock oder Abwesenheit (Stunden). Abwesenheiten ohne Grund/Diagnose.",
            "fields": {
                "person_id": {
                    "type": "ref",
                    "references": "users",
                    "required": true,
                    "label": "Person"
                },
                "datum": {
                    "type": "date",
                    "required": true,
                    "label": "Datum"
                },
                "monat": {
                    "type": "string",
                    "required": true,
                    "label": "Monat (JJJJ-MM)"
                },
                "art": {
                    "type": "enum",
                    "values": {
                        "arbeit": "Arbeit",
                        "abwesenheit": "Abwesenheit"
                    },
                    "required": true,
                    "label": "Art"
                },
                "buchungsart": {
                    "type": "string",
                    "required": false,
                    "label": "Buchungsart (Schlüssel, fehlt = aus Art und Kategorie)"
                },
                "kategorie": {
                    "type": "string",
                    "required": true,
                    "label": "Kategorie / Tätigkeit"
                },
                "beginn": {
                    "type": "string",
                    "required": false,
                    "label": "Beginn (HH:MM)"
                },
                "ende": {
                    "type": "string",
                    "required": false,
                    "label": "Ende (HH:MM)"
                },
                "pause_min": {
                    "type": "int",
                    "required": false,
                    "label": "Pause (Minuten)"
                },
                "stunden": {
                    "type": "decimal",
                    "required": true,
                    "label": "Stunden"
                },
                "projekt": {
                    "type": "string",
                    "required": false,
                    "label": "Projekt / Einsatz"
                },
                "notiz": {
                    "type": "text",
                    "required": false,
                    "label": "Notiz"
                },
                "quelle": {
                    "type": "string",
                    "required": false,
                    "label": "Quelle (leer = von Hand, clicktime = übernommen)"
                },
                "quelle_id": {
                    "type": "string",
                    "required": false,
                    "label": "ID in der Quelle (ClickTime-Nr. der Buchung)"
                }
            }
        },
        "zeit_monate": {
            "label": "Zeiterfassung: Monate",
            "description": "Status je Person und Monat (id = Person:JJJJ-MM): offen, eingereicht, visiert, zurück.",
            "fields": {
                "person_id": {
                    "type": "ref",
                    "references": "users",
                    "required": true,
                    "label": "Person"
                },
                "monat": {
                    "type": "string",
                    "required": true,
                    "label": "Monat (JJJJ-MM)"
                },
                "status": {
                    "type": "enum",
                    "values": {
                        "offen": "Offen",
                        "eingereicht": "Eingereicht",
                        "visiert": "Visiert",
                        "zurueck": "Zurück an Person"
                    },
                    "required": true,
                    "label": "Status"
                },
                "stunden": {
                    "type": "decimal",
                    "required": false,
                    "label": "Stunden total (beim Einreichen)"
                },
                "eingereicht_at": {
                    "type": "datetime",
                    "required": false,
                    "label": "Eingereicht am"
                },
                "visiert_by": {
                    "type": "ref",
                    "references": "users",
                    "required": false,
                    "label": "Visiert von"
                },
                "visiert_at": {
                    "type": "datetime",
                    "required": false,
                    "label": "Visiert am"
                },
                "bemerkung": {
                    "type": "text",
                    "required": false,
                    "label": "Bemerkung Schulleitung"
                },
                "unterschrift_status": {
                    "type": "enum",
                    "values": {
                        "versendet": "Zur Unterschrift",
                        "teilweise": "Teilweise unterschrieben",
                        "unterschrieben": "Unterschrieben",
                        "abgelehnt": "Abgelehnt",
                        "zurueckgezogen": "Zurückgezogen",
                        "abgelaufen": "Abgelaufen",
                        "entwurf": "Entwurf"
                    },
                    "required": false,
                    "label": "Unterschrift (Status)"
                },
                "unterschrift_id": {
                    "type": "string",
                    "required": false,
                    "label": "Unterschrift: Auftrag (signature_requests)"
                },
                "unterschrift_at": {
                    "type": "datetime",
                    "required": false,
                    "label": "Unterschrieben am"
                },
                "unterschrift_pdf": {
                    "type": "string",
                    "required": false,
                    "label": "Unterschriebenes PDF (Ablage des Moduls)"
                }
            }
        },
        "zeit_buchungsarten": {
            "label": "Zeiterfassung: Buchungsarten",
            "description": "Pflegbare Liste (id = Schlüssel): Arbeit oder Abwesenheit. Ohne gespeicherte Liste gilt die Vorgabe.",
            "fields": {
                "name": {
                    "type": "string",
                    "required": true,
                    "label": "Bezeichnung"
                },
                "art": {
                    "type": "enum",
                    "values": {
                        "arbeit": "Arbeit",
                        "abwesenheit": "Abwesenheit"
                    },
                    "required": true,
                    "label": "Art"
                },
                "aktiv": {
                    "type": "bool",
                    "required": true,
                    "label": "Aktiv (zur Auswahl)"
                },
                "reihenfolge": {
                    "type": "int",
                    "required": false,
                    "label": "Reihenfolge"
                }
            }
        }
    },
    "ereignisse": {
        "sendet": [
            "zeit.monat_eingereicht",
            "zeit.monat_visiert",
            "zeit.monat_zurueck",
            "zeit.monat_unterschrieben"
        ],
        "empfaengt": [
            "signatur.unterschrieben",
            "signatur.abgeschlossen",
            "signatur.abgelehnt"
        ]
    },
    "plugins": ["deepsign"]
}
