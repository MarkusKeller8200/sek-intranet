                },
                "url": {
                    "type": "url",
                    "required": false,
                    "label": "URL"
                },
                "notiz": {
                    "type": "text",
                    "required": false,
                    "label": "Notiz"
                },
                "position": {
                    "type": "int",
                    "required": true,
                    "label": "Reihenfolge"
                }
            }
        }
